{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flowlens-txflow",
  "main": "./dist/worker.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "durable_objects": { "bindings": [{ "name": "USAGE_ANALYTICS", "class_name": "UsageAnalytics" }] },
  "migrations": [{ "tag": "flowlens-usage-v1", "new_sqlite_classes": ["UsageAnalytics"] }],
  "observability": { "enabled": false }
}
